{
  "version": 1,
  "pluginsEnabled": true,
  "daemon": {
    "listen": "127.0.0.1:6767",
    "mcp": {
      "injectIntoAgents": true
    },
    "browserTools": {
      "enabled": true
    },
    "terminalProfiles": [
      {
        "id": "claude",
        "name": "Claude Code",
        "command": "claude",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "claude"
      },
      {
        "id": "codex",
        "name": "Codex",
        "command": "codex",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "codex"
      }
    ],
    "relay": {
      "enabled": false
    }
  },
  "agents": {
    "providers": {
      "muse": {
        "enabled": false
      },
      "copilot": {
        "enabled": false
      },
      "opencode": {
        "enabled": false
      },
      "pi": {
        "enabled": false
      },
      "antigravity": {
        "enabled": false
      }
    },
    "resumeOnStartup": true
  }
}

{
  "name": "accountswitch",
  "version": "0.1.3",
  "private": true,
  "description": "Several Claude and ChatGPT subscription accounts for Claude Code and the Codex CLI, with their usage, in one local web page.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "prestart": "npm run build:web",
    "dev": "node src/server/main.ts",
    "build:web": "vite build",
    "build:exe": "npm run build:web && node scripts/build-exe.mjs",
    "build:desktop": "npm run build:exe && node scripts/build-desktop.mjs",
    "build:installer": "npm run build:exe && node scripts/build-desktop.mjs --installer",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.ui.json && tsc -p tsconfig.server.json",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,tsx,mjs,css,json}\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,tsx,mjs,css,json}\" \"*.{json,ts}\""
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "prettier": "3.8.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
